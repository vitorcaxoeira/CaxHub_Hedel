generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String?
  nome         String
  fotoUrl      String?
  roleId       Int
  role         Role     @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())

  /// "pendente" (convite ainda não aceito, sem senha) | "ativo"
  status          String    @default("ativo")
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?

  preferenciaFluxoCaixa PreferenciaFluxoCaixa?
}

/// Preferências do usuário na tela de Fluxo de Caixa. Hoje só o limiar de caixa mínimo, que
/// desenha a linha de corte da curva projetada — é escolha de quem olha, não do sistema, e
/// por isso mora por usuário e não em configuração global.
model PreferenciaFluxoCaixa {
  userId         Int      @id
  limiarCaixaMin Decimal  @default(0) @db.Decimal(15, 2)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("preferencias_fluxo_caixa")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  users       User[]
}

// Registra cada execução do job de sincronização SOAP -> Postgres.
model SyncLog {
  id      Int      @id @default(autoincrement())
  jobName String
  query   String
  status  String
  message String?
  runAt   DateTime @default(now())
  // Resultado da varredura de removidos (sync/varrerRemovidos.ts) desta execução, em
  // forma estruturada — o `message` acima continua tendo o resumo legível. Existe porque
  // em modo "simular" nada é gravado em removidoEmSenior, e sem isso o painel não teria
  // como mostrar o que a simulação detectou. NULL nos dois = execução sem varredura
  // (job ainda não adaptado, sync incremental, ou log anterior ao mecanismo).
  varreduraModo       String?
  varreduraDetectados Int?
  // Instante de referência da varredura (o mesmo carimbado em vistoEmSync). Guardado
  // porque só com ele dá pra LISTAR os candidatos depois: quem tem vistoEmSync anterior
  // a isso não veio na última consulta. Não dá pra deduzir de MAX(vistoEmSync) na
  // tabela, porque um sync parcial (por cliente) carimba um subconjunto com um instante
  // mais novo e envenenaria o máximo.
  varreduraInicio     DateTime?
}

// Espelho local da tabela E070EMP do Senior ERP (empresas cadastradas).
model Empresa {
  codemp  Int      @id
  nomemp  String
  sigemp  String   @db.VarChar(30)
  filiais Filial[]

  @@map("empresa")
}

// Espelho local da tabela E070FIL do Senior ERP (filiais de cada empresa).
model Filial {
  codemp Int
  codfil Int
  nomfil String
  sigfil String

  empresa Empresa @relation(fields: [codemp], references: [codemp])

  @@id([codemp, codfil])
  @@map("filial")
}

// Espelho local da tabela E085CLI do Senior ERP (clientes cadastrados).
model Cliente {
  codcli Int    @id
  nomcli String
  apecli String
  sencli String
  tipcli String
  tipmer String
  tipemc Int
  codram String
  insest String
  cgccpf BigInt
  endcli String
  cplend String
  cepcli Int
  baicli String
  cidcli String
  sigufs String
  codpai String

  titulosReceber TituloReceber[]

  @@map("clientes")
}

// Espelho local da tabela E095FOR do Senior ERP (Cadastros - Fornecedores).
//
// Recorte de 16 dos 150 campos da tabela real — identidade, endereço e situação, no
// mesmo espírito de Cliente/Representante. Fora ficam ~130 campos fiscais de baixíssimo
// uso (regime tributário, PIS/Cofins, DIRF, CBS/IBS, WMS, ANP...) e os 2 campos USU_
// (USU_ReeDesp, USU_GrpFor), que não entram por definição de recorte do projeto — só
// tabela padrão. Sem FK: nenhum outro model referencia CodFor hoje.
model Fornecedor {
  codfor Int    @id
  nomfor String @db.VarChar(100)
  apefor String @db.VarChar(50)
  /// Domínio "LJurFis": J=Pessoa Jurídica, F=Pessoa Física
  tipfor String @db.VarChar(1)
  /// Domínio "LTipMe2": I=Interno (Nacional), E=Externo (Exterior), P=Prospect.
  tipmer String  @db.VarChar(1)
  codram String? @db.VarChar(5)
  insest String? @db.VarChar(25)
  cgccpf BigInt?
  endfor String? @db.VarChar(100)
  cplend String? @db.VarChar(200)
  cepfor Int?
  baifor String? @db.VarChar(75)
  cidfor String? @db.VarChar(60)
  sigufs String? @db.VarChar(2)
  codpai String? @db.VarChar(4)
  /// Domínio "LSitReg": A=Ativo, I=Inativo
  sitfor String @db.VarChar(1)

  notasFiscaisEntrada NotaFiscalEntrada[]

  @@map("fornecedores")
}

// Espelho local da tabela E440NFC do Senior ERP (Compras - Notas Fiscais de Entrada -
// Dados Gerais).
//
// Recorte de 16 dos 251 campos da tabela real — identidade, datas, pagamento, valor e
// situação, no mesmo espírito do recorte de Pedido (E120PED). Fora ficam ~235 campos,
// quase todos cálculo fiscal (ICMS/IPI/PIS/Cofins em dezenas de variantes, DIRF, CBS/IBS,
// dados de importação, CT-e...).
//
// CodCpg/CodFpg/CodMoe ficam SOLTOS, sem @relation — mesmo padrão que Pedido usa para os
// mesmos três campos, resolvido por código de aplicação quando precisar. Dois têm
// sentinela confirmado contra a origem, não são órfãos de FK: CodFpg=0 e CodMoe=' '
// (espaço, não NULL) significam "não informado" em 83.513 e 40.273 das 86.535 linhas —
// o sync converte os dois para NULL antes de gravar (ver notaFiscalEntradaSync.ts).
//
// CodFor é a exceção: FK de verdade para Fornecedor, como TituloReceber -> Cliente.
// Confirmado 0 órfãos nas 86.535 linhas e o campo é obrigatório — mas isso significa que
// fornecedor-sync PRECISA vir antes deste job na ordem de sync/registry.ts (é essa ordem,
// não o horário do cron, que "Sincronizar todas as tabelas" respeita).
model NotaFiscalEntrada {
  codemp Int
  codfil Int
  codfor Int
  numnfc Int
  codsnf String @db.VarChar(3)
  /// Domínio "LTipNfe": 1=NF Entrada, 2=Devolução (NF do Cliente), 3=Devolução (NF de Saída), 4=Retorno (Industrialização), 5=Retorno (Outros), 6=NF Produtor, 7=NF Geração Manual, 8=NF Frete/Serviços Agregados, 9=NF Acerto, 10=NF Acerto (NF Saída), 11=Transferência entre Empresas/Filiais
  tipnfe Int?
  datent DateTime? @db.Date
  datemi DateTime  @db.Date
  // Data da geração do registro — nunca veio nula nas 86.535 linhas conferidas contra a
  // origem, apesar de o dicionário marcar como anulável. Usado como campo de incremental
  // (CAMPO_DATA), mesma escolha e mesma incerteza documentada em tituloReceberSync.ts:
  // pode não capturar toda mudança de situação, só geração ou alteração.
  datger DateTime? @db.Date
  codcpg String  @db.VarChar(6)
  codfpg Int?
  codmoe String? @db.VarChar(3)
  vlrliq Decimal? @db.Decimal(15, 2)
  /// Domínio "LSitNfs": 1=Digitada, 2=Fechada, 3=Cancelada, 4=Documento Fiscal Emitido (saída), 5=Aguardando Fechamento (pós-saída), 6=Aguardando Integração WMS, 7=Digitada Integração, 8=Agrupada
  sitnfc String @db.VarChar(1)
  codmot Int?
  chvnel String? @db.VarChar(50)

  fornecedor Fornecedor @relation(fields: [codfor], references: [codfor])

  @@id([codemp, codfil, codfor, numnfc, codsnf])
  @@map("notas_fiscais_entrada")
}

// Espelho local da tabela E002TPT do Senior ERP (Tabelas - Tipos de Título).
model TipoTitulo {
  codtpt String  @id @db.VarChar(3)
  destpt String  @db.VarChar(40)
  abrtpt String  @db.VarChar(5)
  /// Domínio "LSomTit": D=Soma Duplicatas, O=Soma Outros Títulos, C=Soma Créditos/Pgto. Indevidos
  recsom String  @db.VarChar(1)
  /// Domínio "LSomTit": D=Soma Duplicatas, O=Soma Outros Títulos, C=Soma Créditos/Pgto. Indevidos
  pagsom String  @db.VarChar(1)
  /// Domínio "LAplGrp": A=Ambos, R=Contas a Receber, P=Contas a Pagar
  apltpt String? @db.VarChar(1)
  /// Domínio "LSitReg": A=Ativo, I=Inativo
  sittpt String? @db.VarChar(1)

  titulosReceber TituloReceber[]

  @@map("tipos_titulo")
}

// Espelho local da tabela E301TCR do Senior ERP (C. Receber - Títulos - Dados Gerais).
model TituloReceber {
  codemp Int
  codfil Int
  numtit String   @db.VarChar(15)
  codtpt String   @db.VarChar(3)
  codcli Int
  /// Domínio "LSitTit": AO=Aberto ao Órgão de Proteção ao Crédito, AN=Aberto Negociação, AA=Aberto Advogado, AB=Aberto Normal, AC=Aberto Cartório, AE=Aberto Encontro de Contas, AI=Aberto Impostos, AJ=Aberto Retorno Jurídico, AP=Aberto Protestado, AR=Aberto Representante, AS=Aberto Suspenso, AV=Aberto Gestão de Pessoas, AX=Aberto Externo, CA=Cancelado, CE=Aberto CE (Preparação Cobrança Escritural), CO=Aberto Cobrança, LQ=Liquidado Normal, LC=Liquidado Cartório, LI=Liquidado Impostos, LM=Liquidado Compensado, LO=Liquidado Cobrança, LP=Liquidado Protestado, LS=Liquidado Substituído, LV=Liquidado Gestão de Pessoas, LX=Liquidado Externo, PE=Aberto PE (Pagamento Eletrônico)
  sittit String   @db.VarChar(2)
  datemi DateTime @db.Date
  vctori DateTime @db.Date
  vctpro DateTime @db.Date
  vlrori Decimal  @db.Decimal(15, 2)
  vlrabe Decimal? @db.Decimal(15, 2)
  codpor String?  @db.VarChar(4)

  cliente    Cliente                  @relation(fields: [codcli], references: [codcli])
  tipoTitulo TipoTitulo               @relation(fields: [codtpt], references: [codtpt])
  portador   Portador?                @relation(fields: [codemp, codpor], references: [codemp, codpor])
  movimentos MovimentoTituloReceber[]

  @@id([codemp, codfil, numtit, codtpt])
  @@map("titulos_receber")
}

// Espelho local da tabela E301MCR do Senior ERP (C. Receber - Títulos - Movimentos).
model MovimentoTituloReceber {
  codemp Int
  codfil Int
  numtit String    @db.VarChar(15)
  codtpt String    @db.VarChar(3)
  seqmov Int
  codtns String    @db.VarChar(5)
  datmov DateTime  @db.Date
  datpgt DateTime? @db.Date
  codfpg Int?
  vlrmov Decimal   @db.Decimal(15, 2)
  vlrliq Decimal?  @db.Decimal(15, 2)
  vlrjrs Decimal?  @db.Decimal(15, 2)
  vlrmul Decimal?  @db.Decimal(15, 2)
  vlrdsc Decimal?  @db.Decimal(15, 2)
  diaatr Int?
  codpor String?   @db.VarChar(4)
  codcrt String?   @db.VarChar(2)
  codccu String?   @db.VarChar(9)
  numcco String?   @db.VarChar(14)

  tituloReceber TituloReceber @relation(fields: [codemp, codfil, numtit, codtpt], references: [codemp, codfil, numtit, codtpt])
  transacao     Transacao     @relation(fields: [codemp, codtns], references: [codemp, codtns])

  @@id([codemp, codfil, numtit, codtpt, seqmov])
  @@map("movimentos_receber")
}

// Espelho local da tabela E090REP do Senior ERP (Cadastros - Representantes).
model Representante {
  codrep Int     @id
  nomrep String  @db.VarChar(100)
  aperep String  @db.VarChar(50)
  /// Domínio "LJurFis": J=Pessoa Jurídica, F=Pessoa Física
  tiprep String  @db.VarChar(1)
  cgccpf BigInt?
  /// Domínio "LSitReg": A=Ativo, I=Inativo
  sitrep String  @db.VarChar(1)
  cidrep String? @db.VarChar(60)
  sigufs String? @db.VarChar(2)

  @@map("representantes")
}

// Espelho local da tabela E044CCU do Senior ERP (Cadastros - Centros de Custos).
