# CaxHub_Hedel — espelho da estrutura PADRAO do Senior.
#
# Banco PROPRIO, schema `public`. Nao compartilha database com o CaxHub: o role e dono
# do banco, entao cria no `public` sem GRANT extra (no PG 15+ o `public` pertence a
# `pg_database_owner`).
DATABASE_URL="postgresql://usuario:senha@127.0.0.1:5435/hedel?schema=public"

# Canal de LEITURA do ERP. Nao ha canal de escrita neste projeto.
SOAP_URL="http://host:porta/g5-senior-services/nome_do_servico?wsdl"
SOAP_USER=
SOAP_PASSWORD=

# Varredura de registros removidos no Senior (sync/politicaVarredura.ts). O modo e por
# tabela e vive no codigo; esta variavel e a valvula de emergencia que desliga TODAS de
# uma vez, sem deploy. Unico valor com efeito: `off`. Ausente = cada job usa seu modo.
SYNC_VARREDURA=off

JWT_SECRET=
PORT=3002
